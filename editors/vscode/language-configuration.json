{
  "comments": {
    "lineComment": ";;",
    "blockComment": [ "(;", ";)" ]
  },
  "brackets": [
    [ "(", ")" ]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": [ "string", "comment" ] }
  ],
  "surroundingPairs": [
    [ "(", ")" ],
    [ "\"", "\"" ]
  ],
  "wordPattern": "(\\$[\\w.!#$%&'*+\\-/:<=>?@\\\\^`|~]+)|([a-z][a-z0-9_]*(\\.[a-z0-9_]+)*)|(-?\\d[\\w.]*)"
}
