/target
**/*.rs.bk
/tmp

# Editor workspace settings (the extension's launch configuration is shared)
.vscode/
!/editors/vscode/.vscode/

# VS Code extension build artifacts
/editors/vscode/node_modules/
/editors/vscode/.vscode-test/
/editors/vscode/bin/
*.vsix

# Example build output
/examples/*/target/

# Example editor configurations are part of the examples
!/examples/*/.vscode/
